<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.modbus.simulator</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/RELEASE/PATH/modbus-simulator</string>
    <string>--data-dir</string><string>/ABSOLUTE/DATA/PATH</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/ABSOLUTE/LOG/PATH/launcher.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/LOG/PATH/launcher-error.log</string>
</dict>
</plist>
