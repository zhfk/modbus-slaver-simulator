[Unit]
Description=Modbus simulator with external supervision
After=network.target

[Service]
Type=simple
User=modbus
Group=modbus
WorkingDirectory=/opt/modbus-simulator
ExecStart=/opt/modbus-simulator/modbus-simulator --data-dir /var/lib/modbus-simulator --port 8000
Restart=no
TimeoutStopSec=25
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
